# Automated AI Web Researcher - Environment Configuration Template
# Copy this file to .env and fill in your values
# WARNING: Never commit .env to version control!

# =============================================================================
# LLM Provider Selection
# =============================================================================
# Options: ollama, openai, anthropic
LLM_PROVIDER=ollama

# =============================================================================
# Ollama Configuration (Local LLM on Host)
# =============================================================================
# Base URL for Ollama server running on host machine
# Docker: Use host.docker.internal to reach host from container
# Native: Use localhost or 127.0.0.1
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama model to use (must be pulled first: ollama pull <model>)
# Recommended: phi3:3.8b-mini-128k-instruct, llama3, mistral
OLLAMA_MODEL=phi3:3.8b-mini-128k-instruct

# =============================================================================
# OpenAI Configuration
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# WARNING: This application makes MANY API calls - monitor costs!
OPENAI_API_KEY=

# Optional: Custom base URL for OpenAI-compatible endpoints
# Leave empty for official OpenAI API
OPENAI_BASE_URL=

# Model to use (gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.)
OPENAI_MODEL=gpt-4o

# =============================================================================
# Anthropic Configuration
# =============================================================================
# Get your API key from: https://console.anthropic.com/
# WARNING: This application makes MANY API calls - monitor costs!
ANTHROPIC_API_KEY=

# Model to use (claude-3-5-sonnet-latest, claude-3-5-haiku-latest, etc.)
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# =============================================================================
# LiteLLM Proxy Configuration (Web UI)
# =============================================================================
# Port for LiteLLM web interface
LITELLM_PORT=4000

# Master key for LiteLLM API access
# Change this to a secure random string in production!
LITELLM_MASTER_KEY=sk-1234

# =============================================================================
# Application Settings
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Directories (default paths work in Docker)
LOG_DIR=/app/logs
DATA_DIR=/app/data

# Configuration file path
CONFIG_PATH=/app/config/config.yaml

# =============================================================================
# Advanced Settings (Optional)
# =============================================================================
# Research engine settings
MAX_SEARCHES_PER_CYCLE=5
MAX_FOCUS_AREAS=5

# Web scraping settings
SCRAPING_TIMEOUT=30
SCRAPING_MAX_RETRIES=3
SCRAPING_RATE_LIMIT=1

# =============================================================================
# Development Settings
# =============================================================================
# Enable debug mode
DEBUG=false

# Enable verbose LLM output logging
VERBOSE_LLM_OUTPUT=false

# =============================================================================
# Usage Examples
# =============================================================================
# Example 1: Using Ollama on host (default)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=phi3:3.8b-mini-128k-instruct

# Example 2: Using OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-xxxxx
# OPENAI_MODEL=gpt-4o-mini

# Example 3: Using Anthropic Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Example 4: Using local Ollama with custom model
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3:70b
