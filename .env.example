# =============================================================================
# 📝 CONFIGURATION QUICK REFERENCE
# =============================================================================
# This is your SINGLE SOURCE OF TRUTH - edit values here only!
#
# Where to edit:  .env file (copy from .env.example)
# What gets it:   - Docker Compose (automatic)
#                 - DevContainer (automatic)
#                 - config.yaml (via ${VAR} interpolation)
#                 - Python code (via config_loader.py)
#
# =============================================================================

# 🎯 MAIN SETTINGS - Change these based on your setup
# =============================================================================

## Which LLM provider to use
LLM_PROVIDER=ollama

## Ollama Settings (for local LLM)
## IMPORTANT: Change these TWO lines to switch Ollama setup
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=phi3:3.8b-mini-128k-instruct

## OpenAI Settings (for cloud API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

## Anthropic Settings (for cloud API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# =============================================================================
# 🔧 ADVANCED SETTINGS - Usually don't need to change these
# =============================================================================

## Logging
LOG_LEVEL=INFO

## Directories (Docker paths - change for native install)
LOG_DIR=/app/logs
DATA_DIR=/app/data
CONFIG_PATH=/app/config/config.yaml

## LiteLLM Web UI
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-1234

# =============================================================================
# 📚 EXAMPLES - Uncomment and modify as needed
# =============================================================================

## Example 1: Using Ollama on localhost (native install)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3:8b

## Example 2: Using Ollama on remote server
# OLLAMA_BASE_URL=http://192.168.1.100:11434
# OLLAMA_MODEL=mixtral:8x7b

## Example 3: Using OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-xxxxx
# OPENAI_MODEL=gpt-4o

## Example 4: Custom research settings
# MAX_SEARCHES_PER_CYCLE=10
# MAX_FOCUS_AREAS=7
# SCRAPING_TIMEOUT=60

# =============================================================================
# ✅ HOW TO USE
# =============================================================================
# 1. Copy this file:        cp .env.example .env
# 2. Edit .env:             nano .env  (or your editor)
# 3. Change OLLAMA_MODEL:   phi3:3.8b-mini-128k-instruct
# 4. Change OLLAMA_BASE_URL: http://host.docker.internal:11434
# 5. Run:                   docker-compose up
#
# That's it! All configs update automatically.
# =============================================================================
